{
  "schemaVersion": 1,
  "name": "integ-plugin",
  "version": "1.0.0",
  "description": "Plugin used by the CLI integration tests.",
  "resoloop": { "minVersion": "0.2.0" },
  "commands": [
    { "name": "integ-record", "description": "Records its argv", "program": "dotnet",
      "args": ["${pluginRoot}/probe/CommandProbe.dll", "record", "7"] }
  ],
  "skills": [ { "name": "integ-guide", "path": "skills/integration-guide" } ],
  "recipes": [
    { "name": "card", "path": "recipes/card.json", "prototype": "integ.card", "purpose": "Integration card",
      "parameters": { "key": "Stable key" } }
  ],
  "tools": [
    { "name": "missing", "executable": "resoloop-integ-missing-tool", "versionArgs": ["--version"], "required": true,
      "hint": "Install the integration tool." }
  ]
}
